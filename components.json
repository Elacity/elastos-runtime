    "vmlinux": {
      "install_path": "bin/vmlinux",
      "description": "ElastOS guest kernel (6.1.59, CONFIG_VIRTIO_CONSOLE=y) for crosvm/Vz capsule boot. On darwin-arm64 the artifact is a same-source recompile for ARM64 (PHASE_0_SCOPE.md \u00a7 C.3 Decision A); build recipe at scripts/build-vmlinux-arm64.sh.",
      "platforms": {
        "linux-amd64": {
          "cid": "Qmeb1qaqfMiri7G123FWmMz6qt74xhPjAgAJEy8ZSrFKh7",
          "checksum": "sha256:eccb4f318ba37309af5fae01bc610b76033707ec8149002d26675aed66d8578b",
          "install_path": "bin/vmlinux"
        },
        "linux-arm64": {
          "strategy": "local-copy",
          "source": "/boot/Image",
          "note": "Upstream crosvm aarch64 test kernel is broken on GICv3-only hosts (Jetson). Uses host kernel instead.",
          "install_path": "bin/vmlinux"
        },
        "darwin-arm64": {
          "url": "https://cloud-images.ubuntu.com/releases/jammy/release-20260515/unpacked/ubuntu-22.04-server-cloudimg-arm64-vmlinuz-generic",
          "checksum": "sha256:b712ef9919cad88f85e25e4b924c3dacde74e866363867b7b447b7841909462a",
          "size": 15392425,
          "compression": "gzip",
          "install_path": "bin/vmlinux",
          "note": "Pinned Ubuntu 22.04 LTS arm64 kernel (5.15.0-179-generic, immutable release-20260515 path). The URL serves the gzip-compressed + EFI-signed vmlinuz Canonical publishes; `checksum`/`size` describe those AS-DOWNLOADED bytes (matches Canonical's SHA256SUMS). The fetcher gunzips the verified bytes into install_path as a raw ARM64 Image that VZLinuxBootLoader accepts. See docs/vz-backend/PHASE_7_DAY_1_NOTES.md for the A-vs-B decision and PHASE_7_DAY_2_NOTES.md for the wiring."
        }
      }
    },
    "initrd": {
      "install_path": "bin/initrd",
      "description": "Initial ramdisk that brings up userspace on the Mac (Vz) microVM path. Loads virtio_blk/virtio_net/virtio_vsock as modules before mounting the rootfs — required because Ubuntu's generic kernel ships those drivers as modules, not built-in. Not installed on Linux: crosvm boots vmlinux + rootfs directly without a separate initrd.",
      "platforms": {
        "darwin-arm64": {
          "url": "https://cloud-images.ubuntu.com/releases/jammy/release-20260515/unpacked/ubuntu-22.04-server-cloudimg-arm64-initrd-generic",
          "checksum": "sha256:8cb79fdcbf90313d7a5a315a2dc90bca7435976c3603a28929bce5feefab2b1c",
          "size": 33053012,
          "install_path": "bin/initrd",
          "note": "Pinned Ubuntu 22.04 LTS arm64 initrd (immutable release-20260515 path). The initrd is zstd-compressed inside Canonical's wrapper; Linux 5.15+ self-decompresses zstd initramfs at boot time, so Vz passes the bytes through verbatim. See docs/vz-backend/PHASE_7_DAY_2_NOTES.md."
        }
      }
    },
