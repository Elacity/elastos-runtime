{
  "schema": "elastos.capsule/v1",
  "name": "home",
  "version": "0.1.0",
  "description": "Open ElastOS and choose your Home view",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.shell.host",
      "version": "0.5.0",
      "description": "Sign in and choose the Home view shown after launch",
      "methods": [
        {
          "id": "auth.unlock",
          "description": "Unlock Home with your passkey",
          "risk": "read",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://home/session",
          "operation": "unlock"
        },
        {
          "id": "shell.resolve",
          "description": "Open the selected Home view",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://home/shell",
          "operation": "resolve"
        },
        {
          "id": "shell.switch",
          "description": "Switch between available Home views",
          "risk": "privileged",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://home/shell",
          "operation": "switch"
        }
      ]
    }
  ],
  "requires": [],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {
    "storage": [],
    "messaging": []
  }
}
