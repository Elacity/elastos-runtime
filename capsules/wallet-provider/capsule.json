{
  "schema": "elastos.capsule/v1",
  "name": "wallet-provider",
  "version": "0.2.0",
  "description": "Wallet authority provider for proof challenges, linked accounts, and typed signing approvals",
  "author": "elastos",
  "role": "provider",
  "type": "microvm",
  "entrypoint": "rootfs.ext4",
  "provides": "elastos://wallet/meta/status",
  "authority": {
    "reason": "Owns Wallet proof challenges, connector-bound account metadata, typed approval flows, and managed Recovery Kit operations behind an authenticated Runtime-local Wallet Bus.",
    "capabilities": [
      {
        "resource": "elastos://wallet/meta/status",
        "actions": ["read"],
        "operations": ["status"]
      }
    ],
    "audit_events": [
      "wallet.status",
      "wallet.managed.created",
      "wallet.account_link",
      "wallet.account_revoke",
      "wallet.account.deleted",
      "wallet.account.renamed",
      "wallet.recovery_key.viewed",
      "wallet.default.updated",
      "wallet.proof",
      "wallet.sign_request",
      "wallet.approval_reject",
      "wallet.approval_approve",
      "wallet.approval_complete"
    ]
  },
  "interfaces": [
    {
      "id": "elastos.provider.wallet",
      "version": "0.6.0",
      "description": "Public Wallet provider metadata surface; private Wallet Bus operations are Runtime-local and are not generic provider methods.",
      "methods": [
        {
          "id": "status",
          "description": "Read wallet-provider status metadata.",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://wallet/meta/status",
          "operation": "status"
        }
      ]
    }
  ],
  "capabilities": ["localhost://ElastOS/SystemServices/Wallet/*"],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {}
}
