{
  "schema": "elastos.capsule/v1",
  "name": "chain-provider",
  "version": "0.1.0",
  "description": "Typed chain provider for production Elastos, Base, and Bitcoin operations",
  "author": "elastos",
  "role": "provider",
  "type": "microvm",
  "entrypoint": "rootfs.ext4",
  "provides": "elastos://chain/*",
  "authority": {
    "reason": "Provides typed chain status, proofs, transaction intents, broadcasts, and managed node lifecycle without exposing raw node RPC URLs to app capsules.",
    "capabilities": [
      {
        "resource": "elastos://chain/*",
        "actions": ["read", "write", "admin"],
        "operations": ["networks", "status", "block_number", "sync_health", "balance", "transaction", "receipt", "has_access_by_content_id", "proof", "erc1271_is_valid_signature", "prepare_transaction", "broadcast_transaction", "node_lifecycle"]
      }
    ],
    "audit_events": ["chain.read", "chain.status", "chain.rights_read", "chain.proof", "chain.broadcast", "chain.node_lifecycle"]
  },
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {}
}
