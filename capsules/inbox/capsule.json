{
  "schema": "elastos.capsule/v1",
  "name": "inbox",
  "version": "0.2.0",
  "description": "Review requests",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.inbox.approvals",
      "version": "0.5.0",
      "description": "Review and respond to requests",
      "methods": [
        {
          "id": "requests.list",
          "description": "List pending and recent requests",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://inbox/requests",
          "operation": "list"
        },
        {
          "id": "request.approve",
          "description": "Approve a request after confirming your identity when needed",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://inbox/request",
          "operation": "approve"
        },
        {
          "id": "request.deny",
          "description": "Deny a request",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://inbox/request",
          "operation": "deny"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
