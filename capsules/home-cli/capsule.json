{
  "schema": "elastos.capsule/v1",
  "name": "home-cli",
  "version": "0.1.0",
  "description": "Runtime-owned Home CLI shell over PTY, Home facts, and structured Home intents",
  "author": "elastos",
  "role": "shell",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "terminal", "cli", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.shell.cli",
      "version": "0.5.0",
      "description": "Command shell over Runtime facts and structured Home intents",
      "methods": [
        {
          "id": "facts.search",
          "description": "Search Home, capsule, interface, service, people, and Inbox facts",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://home/facts",
          "operation": "search"
        },
        {
          "id": "capsule.open",
          "description": "Ask Home to open a visible capsule through a structured Home intent",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://capsules/*",
          "operation": "launch"
        },
        {
          "id": "shell.switch",
          "description": "Request an active root shell switch through Runtime active-shell state",
          "risk": "privileged",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://home/shell",
          "operation": "switch"
        }
      ]
    }
  ],
  "requires": [],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {
    "storage": [],
    "messaging": []
  }
}
