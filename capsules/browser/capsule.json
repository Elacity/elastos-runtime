{
  "schema": "elastos.capsule/v1",
  "name": "browser",
  "version": "0.1.0",
  "description": "Browse websites with your chosen Browser Engine and Exit Node",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.browser.page",
      "version": "0.5.0",
      "description": "Open and control web pages",
      "methods": [
        {
          "id": "page.open",
          "description": "Open a page with the selected Browser Engine and Exit Node",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://browser/page",
          "operation": "open"
        },
        {
          "id": "page.navigate",
          "description": "Go to another page",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://browser/page",
          "operation": "navigate"
        },
        {
          "id": "page.input",
          "description": "Send keyboard and pointer input to the page",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://browser/page",
          "operation": "input"
        },
        {
          "id": "page.close",
          "description": "Close the active page",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://browser/page",
          "operation": "close"
        },
        {
          "id": "display.attach",
          "description": "Connect video and audio from the Browser Engine",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://browser/display",
          "operation": "attach"
        },
        {
          "id": "exit.select",
          "description": "Select a Browser Exit offer for future Browser traffic",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://browser/exit",
          "operation": "select"
        },
        {
          "id": "profile.reset",
          "description": "Reset isolated Browser profile storage and cookies",
          "risk": "write",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://browser/profile",
          "operation": "reset"
        },
        {
          "id": "wallet.request",
          "description": "Send a website signing request to Wallet and Inbox",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://browser/wallet-bridge",
          "operation": "request"
        }
      ]
    }
  ],
  "capabilities": [
    "elastos://browser/page",
    "elastos://browser/display",
    "elastos://browser/exit",
    "elastos://browser/profile",
    "elastos://browser/wallet-bridge"
  ],
  "requires": [
    { "name": "browser-engine-adapter", "kind": "capsule" },
    { "name": "exit-provider", "kind": "capsule" },
    { "name": "net-provider", "kind": "capsule" },
    { "name": "wallet-provider", "kind": "capsule" }
  ],
  "resources": {
    "memory_mb": 32,
    "gpu": false
  }
}
