{
  "schema": "elastos.capsule/v1",
  "name": "browser",
  "version": "0.1.0",
  "description": "Browse web sites through the ElastOS Browser boundary",
  "author": "elastos",
  "role": "app",
  "type": "data",
  "entrypoint": "index.html",
  "capabilities": [
    "elastos://wallet/*",
    "elastos://net/resolve",
    "elastos://net/connect",
    "elastos://net/stream",
    "elastos://net/http"
  ],
  "resources": {
    "memory_mb": 32,
    "gpu": false
  }
}
