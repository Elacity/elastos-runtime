{
  "schema": "elastos.capsule/v1",
  "name": "people",
  "version": "0.1.0",
  "description": "Manage profile details and contacts, and view signed online presence",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.people.contacts",
      "version": "0.6.0",
      "description": "Manage profile and contacts and read signed online presence",
      "methods": [
        {
          "id": "people.summary",
          "description": "Read the current profile and contacts",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://people",
          "operation": "read"
        },
        {
          "id": "profile.update",
          "description": "Update the display name shared with connected people",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://people/profile",
          "operation": "update"
        },
        {
          "id": "presence.read",
          "description": "Read verified, unexpired online presence for the configured collaboration network",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://people/presence",
          "operation": "read"
        },
        {
          "id": "contacts.remove",
          "description": "Remove a person from the local contact list",
          "risk": "write",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://people/contacts",
          "operation": "remove"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
