{
  "schema": "elastos.capsule/v1",
  "name": "wallet-walletconnect",
  "version": "0.1.0",
  "description": "Connect WalletConnect as an optional approval method",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.wallet.approval-method",
      "version": "0.5.0",
      "description": "WalletConnect approval method projection",
      "methods": [
        {
          "id": "method.connect",
          "description": "Connect WalletConnect as a Wallet approval method",
          "risk": "privileged",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://wallet/approval-method/walletconnect",
          "operation": "connect"
        },
        {
          "id": "approval.review",
          "description": "Review an approval routed from Wallet before any connector effect",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://wallet/approval",
          "operation": "review"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
