{
  "schema": "elastos.capsule/v1",
  "name": "ai-provider",
  "version": "0.1.0",
  "description": "AI provider - routes LLM requests to local llama, Venice, or local Codex CLI",
  "author": "elastos",
  "role": "provider",
  "type": "microvm",
  "entrypoint": "rootfs.ext4",
  "requires": [
    { "name": "llama-provider", "kind": "capsule" }
  ],
  "provides": "elastos://ai/*",
  "authority": {
    "reason": "Routes AI requests to configured model providers without exposing model processes or hosted API credentials to app capsules.",
    "capabilities": [
      {
        "resource": "elastos://ai/*",
        "actions": ["read"],
        "operations": ["list_backends", "ping"]
      },
      {
        "resource": "elastos://ai/*",
        "actions": ["execute"],
        "operations": ["chat_completions"]
      }
    ],
    "audit_events": ["ai.request", "ai.backend_select"]
  },
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {}
}
