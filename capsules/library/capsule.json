{
  "schema": "elastos.capsule/v1",
  "name": "library",
  "version": "0.1.0",
  "description": "Browse local files, folders, and published content",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.library.objects",
      "version": "0.5.0",
      "description": "Browse files and choose content for other apps",
      "methods": [
        {
          "id": "objects.browse",
          "description": "Browse your files and folders",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://library/objects",
          "operation": "browse"
        },
        {
          "id": "object.open",
          "description": "Open a selected item with a compatible app",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://library/object",
          "operation": "open"
        },
        {
          "id": "object.choose",
          "description": "Choose an item for the app that opened Library",
          "risk": "read",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://library/object",
          "operation": "choose"
        }
      ]
    }
  ],
  "requires": [
    { "name": "object-provider", "kind": "capsule" }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
