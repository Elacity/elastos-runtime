{
  "schema": "elastos.capsule/v1",
  "name": "system",
  "version": "0.2.0",
  "description": "Manage your account, appearance, security, apps, and device",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.system.shell",
      "version": "0.5.0",
      "description": "System settings",
      "methods": [
        {
          "id": "shells.list",
          "description": "List available Home views",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://home/shells",
          "operation": "list"
        },
        {
          "id": "shell.switch",
          "description": "Switch the current Home view",
          "risk": "privileged",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://home/shell",
          "operation": "switch"
        },
        {
          "id": "settings.update",
          "description": "Update Home settings",
          "risk": "write",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://system/settings",
          "operation": "update"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 32,
    "gpu": false
  }
}
