{
  "schema": "elastos.capsule/v1",
  "name": "wallet",
  "version": "0.1.0",
  "description": "View Wallet accounts, balances, approvals, and approval methods",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "entrypoint": "wallet.wasm",
  "interfaces": [
    {
      "id": "elastos.wallet.accounts",
      "version": "0.5.0",
      "description": "Wallet account, balance, and approval projection",
      "methods": [
        {
          "id": "accounts.view",
          "description": "View Runtime-linked wallet accounts and balances",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://wallet/accounts",
          "operation": "view"
        },
        {
          "id": "approval.review",
          "description": "Review a wallet approval request before signing",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://wallet/approval",
          "operation": "review"
        },
        {
          "id": "approval.sign",
          "description": "Sign only after Wallet/Inbox approval and fresh proof when required",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://wallet/sign",
          "operation": "sign"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
