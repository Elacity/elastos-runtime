{
  "schema": "elastos.capsule/v1",
  "name": "wallet",
  "version": "0.2.0",
  "description": "View Wallet accounts, balances, approvals, and approval methods",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.wallet.accounts",
      "version": "0.5.0",
      "description": "Manage Wallet accounts, balances, and approvals",
      "methods": [
        {
          "id": "accounts.view",
          "description": "View wallet accounts and balances",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://wallet/accounts",
          "operation": "view"
        },
        {
          "id": "approval.review",
          "description": "Review a request before signing",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://wallet/approval",
          "operation": "review"
        },
        {
          "id": "approval.sign",
          "description": "Sign only after approval and passkey confirmation when required",
          "risk": "payment",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://wallet/sign",
          "operation": "sign"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
