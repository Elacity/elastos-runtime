{
  "schema": "elastos.capsule/v1",
  "name": "marketplace",
  "version": "0.2.0",
  "description": "Browse apps, viewers, services, and content available in ElastOS",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.marketplace.catalog",
      "version": "0.5.0",
      "description": "Browse and open available software",
      "methods": [
        {
          "id": "capsules.browse",
          "description": "Browse available apps and content",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://marketplace/catalog",
          "operation": "browse"
        },
        {
          "id": "capsule.inspect",
          "description": "Review verification, payment, and access details",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://marketplace/capsule",
          "operation": "inspect"
        },
        {
          "id": "capsule.install",
          "description": "Request an app installation",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://marketplace/install",
          "operation": "install"
        }
      ]
    },
    {
      "id": "elastos.marketplace.protected-content",
      "version": "0.1.0",
      "description": "Buy listed protected content and import it into Library",
      "methods": [
        {
          "id": "content.buy",
          "description": "Buy one copy of a listed protected item with the default wallet.",
          "risk": "write",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://object/*",
          "operation": "buy"
        },
        {
          "id": "content.import",
          "description": "Import a bought protected item into Library.",
          "risk": "write",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://object/*",
          "operation": "import_runtime_custody"
        },
        {
          "id": "content.list",
          "description": "List protected items available to buy.",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://object/*",
          "operation": "list_runtime_custody"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
