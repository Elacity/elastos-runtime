{
  "schema": "elastos.capsule/v1",
  "name": "llama-provider",
  "version": "0.1.0",
  "description": "Local LLM inference via llama-server",
  "author": "elastos",
  "role": "provider",
  "type": "microvm",
  "entrypoint": "rootfs.ext4",
  "requires": [
    { "name": "llama-server", "kind": "external" },
    { "name": "model-qwen3.5-0.8b", "kind": "external" }
  ],
  "provides": "elastos://llama/*",
  "authority": {
    "reason": "Owns local llama-server model process access so app capsules receive AI results without model process or TCP-port authority.",
    "capabilities": [
      {
        "resource": "elastos://llama/*",
        "actions": ["execute"],
        "operations": ["chat_completions", "status", "health", "list_models"]
      }
    ],
    "audit_events": ["llama.request", "llama.status"]
  },
  "interfaces": [
    {
      "id": "elastos.provider.llama",
      "version": "0.5.0",
      "description": "Runtime provider affordance descriptors projected from llama-provider authority metadata; descriptors are not grants.",
      "methods": [
        {
          "id": "chat_completions",
          "description": "Request chat completions through the llama-provider Runtime provider boundary for elastos://llama/*.",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://llama/*",
          "operation": "chat_completions"
        },
        {
          "id": "status",
          "description": "Request status through the llama-provider Runtime provider boundary for elastos://llama/*.",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://llama/*",
          "operation": "status"
        },
        {
          "id": "health",
          "description": "Request health through the llama-provider Runtime provider boundary for elastos://llama/*.",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://llama/*",
          "operation": "health"
        },
        {
          "id": "list_models",
          "description": "Request list models through the llama-provider Runtime provider boundary for elastos://llama/*.",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://llama/*",
          "operation": "list_models"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 4096,
    "gpu": true
  },
  "microvm": {
    "http_port": 11434
  }
}
