{
  "schema": "elastos.capsule/v1",
  "name": "archive-manager",
  "version": "0.1.0",
  "description": "Browse and extract supported archive contents through Library",
  "role": "viewer",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.archive.viewer",
      "version": "0.5.0",
      "description": "Archive browsing and extraction through Library and object-provider facts",
      "methods": [
        {
          "id": "archive.open",
          "description": "Open an archive object through the Runtime viewer route",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://archive/object",
          "operation": "open",
          "input_schema": {
            "schema": "elastos.archive.open/v1",
            "accepts": [
              {
                "kind": "library_object",
                "extensions": [".zip", ".tar", ".tar.gz", ".tgz"],
                "mime": ["application/zip", "application/x-tar", "application/gzip"],
                "mode": "browse_and_extract"
              },
              {
                "kind": "library_object",
                "extensions": [
                  ".7z",
                  ".rar",
                  ".gz",
                  ".xz",
                  ".bz2",
                  ".zst",
                  ".lz4",
                  ".tar.xz",
                  ".txz",
                  ".tar.bz2",
                  ".tbz2",
                  ".tar.zst",
                  ".tzst"
                ],
                "mode": "unsupported_family_diagnostic"
              }
            ]
          }
        },
        {
          "id": "entry.extract",
          "description": "Extract an archive entry into a Runtime-owned object namespace",
          "risk": "write",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://archive/entry",
          "operation": "extract"
        }
      ]
    }
  ],
  "requires": [
    { "name": "object-provider", "kind": "capsule" }
  ],
  "resources": {
    "memory_mb": 24,
    "gpu": false
  }
}
