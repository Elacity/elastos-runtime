{
  "schema": "elastos.capsule/v1",
  "name": "chat-wasm",
  "version": "0.1.0",
  "description": "P2P chat client - WASM stdio variant (same wire format as microVM chat)",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "entrypoint": "chat-stdio.wasm",
  "interfaces": [
    {
      "id": "elastos.chat.terminal",
      "version": "0.5.0",
      "description": "Interactive chat terminal over Runtime/Carrier chat transport",
      "methods": [
        {
          "id": "session.open",
          "description": "Open an interactive chat session through Runtime lifecycle control",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://chat/session",
          "operation": "open"
        },
        {
          "id": "message.send",
          "description": "Send a chat message through Carrier-backed Runtime transport",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://chat/message",
          "operation": "send"
        }
      ]
    }
  ],
  "requires": [],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {
    "storage": ["localhost://Users/self/.AppData/LocalHost/Chat/*"],
    "messaging": []
  }
}
