{
  "schema": "elastos.capsule/v1",
  "name": "chat-room",
  "version": "0.1.0",
  "description": "Runtime-launched Chat capsule with a web surface adapter",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates", "carrier"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.chat.room",
      "version": "0.5.0",
      "description": "Chat room projection over Runtime room facts and Carrier-backed intents",
      "methods": [
        {
          "id": "room.view",
          "description": "View room membership, invites, guests, and message facts",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://chat/room",
          "operation": "view"
        },
        {
          "id": "message.send",
          "description": "Send a chat message through Runtime room and Carrier policy",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://chat/message",
          "operation": "send"
        },
        {
          "id": "guest.approve",
          "description": "Approve a guest access request through Runtime room policy",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://chat/guest",
          "operation": "approve"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 32,
    "gpu": false
  }
}
