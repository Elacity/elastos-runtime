{
  "schema": "elastos.capsule/v1",
  "name": "agent",
  "version": "0.1.0",
  "description": "AI chat agent - joins P2P channels and responds via LLM",
  "author": "elastos",
  "role": "app",
  "type": "microvm",
  "entrypoint": "rootfs.ext4",
  "interfaces": [
    {
      "id": "elastos.agent.chat",
      "version": "0.5.0",
      "description": "Agent chat participant projection over DID, room, and LLM provider facts",
      "methods": [
        {
          "id": "agent.join",
          "description": "Join an allowed chat context as an agent participant",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://agent/chat",
          "operation": "join"
        },
        {
          "id": "message.respond",
          "description": "Respond to messages through Runtime-governed agent policy",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://agent/message",
          "operation": "respond"
        }
      ]
    }
  ],
  "requires": [
    { "name": "did-provider", "kind": "capsule" }
  ],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  }
}
