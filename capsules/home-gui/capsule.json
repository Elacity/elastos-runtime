{
  "schema": "elastos.capsule/v1",
  "name": "home-gui",
  "version": "0.1.0",
  "description": "Desktop Home view for ElastOS",
  "author": "elastos",
  "role": "shell",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.shell.gui",
      "version": "0.5.0",
      "description": "Desktop, launcher, taskbar, and app windows",
      "methods": [
        {
          "id": "desktop.render",
          "description": "Show the ElastOS desktop",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://home/desktop",
          "operation": "render"
        },
        {
          "id": "capsule.open",
          "description": "Open an available app",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://capsules/*",
          "operation": "launch"
        },
        {
          "id": "shell.switch",
          "description": "Switch to another Home view",
          "risk": "privileged",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://home/shell",
          "operation": "switch"
        }
      ]
    }
  ],
  "requires": [],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {
    "storage": [],
    "messaging": []
  }
}
