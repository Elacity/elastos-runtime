{
  "schema": "elastos.capsule/v1",
  "name": "home-gui",
  "version": "0.1.0",
  "description": "Trusted host-loaded Home GUI shell surface for ElastOS",
  "author": "elastos",
  "role": "shell",
  "type": "wasm",
  "entrypoint": "home-gui.wasm",
  "interfaces": [
    {
      "id": "elastos.shell.gui",
      "version": "0.5.0",
      "description": "Trusted host-loaded desktop shell projection over Runtime facts and signed Home host intents",
      "methods": [
        {
          "id": "desktop.render",
          "description": "Render desktop, launcher, taskbar, and windows inside the trusted Home host from Home facts",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://home/desktop",
          "operation": "render"
        },
        {
          "id": "capsule.open",
          "description": "Ask the Home host to open a visible capsule window through Runtime launch authority",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://capsules/*",
          "operation": "launch"
        },
        {
          "id": "shell.switch",
          "description": "Switch the active root Home shell through Runtime active-shell state",
          "risk": "privileged",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://home/shell",
          "operation": "switch"
        }
      ]
    }
  ],
  "requires": [],
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {
    "storage": [],
    "messaging": []
  }
}
