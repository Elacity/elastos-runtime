{
  "schema": "elastos.capsule/v1",
  "name": "services",
  "version": "0.1.0",
  "description": "Share Browser Engine and Browser Exit services with people",
  "author": "elastos",
  "role": "app",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.services.offers",
      "version": "0.5.0",
      "description": "Choose Browser Engine and Browser Exit services",
      "methods": [
        {
          "id": "offers.list",
          "description": "List available Browser Engine and Browser Exit offers",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "summary",
          "resource": "elastos://services/offers",
          "operation": "list"
        },
        {
          "id": "browser.exit.select",
          "description": "Select a permitted Browser Exit offer",
          "risk": "write",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://browser/exit",
          "operation": "select"
        },
        {
          "id": "offer.request",
          "description": "Request access to a service shared by another device",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://services/offers",
          "operation": "request"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 16,
    "gpu": false
  }
}
