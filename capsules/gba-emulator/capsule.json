{
  "schema": "elastos.capsule/v1",
  "name": "gba-emulator",
  "version": "0.2.0",
  "description": "Play GBA games",
  "role": "viewer",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "icon": "browser/icons",
  "interfaces": [
    {
      "id": "elastos.gba.emulator",
      "version": "0.5.0",
      "description": "Play compatible GBA games from Library",
      "methods": [
        {
          "id": "game.open",
          "description": "Open a compatible GBA game",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://content/asset",
          "operation": "open",
          "input_schema": {
            "schema": "elastos.gba.rom-open/v1",
            "accepts": [
              {
                "kind": "content_capsule",
                "role": "content",
                "type": "data",
                "viewer": "gba-emulator"
              },
              {
                "kind": "file",
                "extensions": [".gba"],
                "mime": ["application/x-gba-rom", "application/octet-stream"]
              }
            ]
          }
        }
      ]
    }
  ],
  "permissions": {
    "storage": ["localhost://Users/self/.AppData/LocalHost/GBA/*"]
  },
  "requires": [
    { "name": "object-provider", "kind": "capsule" }
  ],
  "resources": {
    "memory_mb": 192,
    "gpu": false
  }
}
