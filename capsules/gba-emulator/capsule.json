{
  "schema": "elastos.capsule/v1",
  "name": "gba-emulator",
  "version": "0.1.0",
  "description": "Play GBA games",
  "role": "viewer",
  "type": "wasm",
  "author": "elastos",
  "entrypoint": "gba-emulator.wasm",
  "interfaces": [
    {
      "id": "elastos.gba",
      "version": "0.1.0",
      "description": "Play Game Boy Advance game objects.",
      "methods": [
        {
          "id": "game.play",
          "description": "Load and run a GBA game object.",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "input_schema": {
            "type": "object",
            "properties": { "uri": { "type": "string", "description": "Object URI of the GBA game to play." } },
            "required": ["uri"]
          },
          "output_schema": { "type": "object" }
        }
      ]
    }
  ],
  "permissions": {
    "storage": ["localhost://Users/self/.AppData/LocalHost/GBA/*"]
  },
  "resources": {
    "memory_mb": 128,
    "gpu": false
  }
}
