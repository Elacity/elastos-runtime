{
  "schema": "elastos.capsule/v1",
  "name": "documents",
  "version": "0.1.0",
  "description": "Create, edit, and publish markdown documents",
  "role": "viewer",
  "type": "wasm",
  "runtime_abi": "elastos.runtime-projection/v1",
  "bus_contract": "elastos.runtime-projection/v1",
  "execution": "web-projection",
  "projections": ["web", "facts", "affordances", "gates"],
  "author": "elastos",
  "entrypoint": "browser/index.html",
  "interfaces": [
    {
      "id": "elastos.documents.editor",
      "version": "0.5.0",
      "description": "Document editor projection over Runtime object storage and publication intents",
      "methods": [
        {
          "id": "document.open",
          "description": "Open a document object through the Runtime viewer route",
          "risk": "read",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://documents/document",
          "operation": "open",
          "input_schema": {
            "schema": "elastos.documents.document-open/v1",
            "accepts": [
              {
                "kind": "library_object",
                "extensions": [".md", ".txt"],
                "mime": ["text/plain", "text/markdown"]
              }
            ]
          }
        },
        {
          "id": "document.save",
          "description": "Save a document through the object-provider backed namespace",
          "risk": "write",
          "approval": "user",
          "audit": "event",
          "resource": "elastos://documents/document",
          "operation": "save"
        },
        {
          "id": "document.publish",
          "description": "Request publication of a document through Runtime publication gates",
          "risk": "privileged",
          "approval": "user",
          "audit": "full",
          "resource": "elastos://documents/publication",
          "operation": "publish"
        }
      ]
    }
  ],
  "resources": {
    "memory_mb": 24,
    "gpu": false
  }
}
