{
  "schema": "elastos.capsule/v1",
  "name": "gba-ucity",
  "version": "0.1.0",
  "description": "uCity - open-source city builder for GBA",
  "role": "content",
  "type": "data",
  "author": "elastos",
  "entrypoint": "ucity.gba",
  "viewer": "gba-emulator",
  "interfaces": [
    {
      "id": "elastos.content.asset",
      "version": "0.5.0",
      "description": "Launchable content asset descriptor for viewer-based capsules",
      "methods": [
        {
          "id": "asset.open",
          "description": "Open this content asset with its declared Runtime viewer",
          "risk": "launch",
          "approval": "runtime_policy",
          "audit": "event",
          "resource": "elastos://content/asset",
          "operation": "open"
        }
      ]
    }
  ],
  "permissions": {
    "storage": ["localhost://Users/self/.AppData/LocalHost/GBA/gba-ucity/*"]
  }
}
