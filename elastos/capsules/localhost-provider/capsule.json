{
  "schema": "elastos.capsule/v1",
  "name": "localhost-provider",
  "version": "0.1.0",
  "description": "Localhost provider - secure access to local machine resources",
  "author": "elastos",
  "role": "provider",
  "type": "microvm",
  "entrypoint": "rootfs.ext4",
  "provides": "localhost://*",
  "authority": {
    "reason": "Owns rooted local object storage for approved localhost:// roots without leaking arbitrary host filesystem paths.",
    "capabilities": [
      {
        "resource": "localhost://*",
        "actions": ["read", "write", "delete"],
        "operations": ["read", "write", "list", "delete", "stat", "mkdir", "exists"]
      }
    ],
    "audit_events": ["localhost.read", "localhost.write", "localhost.delete"]
  },
  "resources": {
    "memory_mb": 64,
    "gpu": false
  },
  "permissions": {
    "storage": [
      "localhost://UsersAI/",
      "localhost://AppCapsules/",
      "localhost://ElastOS/",
      "localhost://Local/",
      "localhost://MyWebSite/",
      "localhost://Public/",
      "localhost://Users/"
    ],
    "messaging": ["*"]
  }
}
