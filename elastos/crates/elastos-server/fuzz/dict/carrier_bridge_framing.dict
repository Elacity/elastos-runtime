# Carrier-bridge framing fuzz dictionary.
# Each entry biases libfuzzer mutations toward syntactically
# plausible envelopes. Format: bash-style strings, one per line.
#
# JSON structural tokens
"\"{\""
"\"}\""
"\"[\""
"\"]\""
"\":\""
"\",\""
"\"null\""
"\"true\""
"\"false\""
# Envelope keys
"\"id\""
"\"request\""
"\"response\""
"\"type\""
"\"error\""
"\"code\""
"\"message\""
# RuntimeRequest type values (elastos-guest/src/runtime.rs RuntimeRequest enum)
"\"ping\""
"\"get_runtime_info\""
"\"list_capsules\""
"\"launch_capsule\""
"\"stop_capsule\""
"\"send_message\""
"\"receive_messages\""
"\"fetch_content\""
"\"storage_read\""
"\"storage_write\""
"\"grant_capability\""
"\"revoke_capability\""
"\"request_capability\""
"\"provider_call\""
# Provider call schemes / ops
"\"localhost\""
"\"did\""
"\"peer\""
"\"ai\""
"\"read\""
"\"write\""
"\"list\""
# Capability resource shapes
"\"localhost://\""
"\"elastos://\""
"\"Users/self/.AppData/\""
# Token / id values
"\"token\""
"\"resource\""
"\"action\""
"\"scheme\""
"\"op\""
"\"body\""
"\"path\""
"\"uri\""
"\"capsule_id\""
"\"cid\""
"\"to\""
"\"payload\""
"\"reply_to\""
# Error envelope keywords
"\"bridge_error\""
"\"request_too_large\""
