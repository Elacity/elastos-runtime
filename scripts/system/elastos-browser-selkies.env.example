# Copy to /etc/elastos/browser-selkies.env and adjust for the host.

ELASTOS_BROWSER_SELKIES_REPO=/opt/elastos-runtime
ELASTOS_BROWSER_SELKIES_OUT_DIR=/tmp/elastos-browser-selkies-live
ELASTOS_BROWSER_SELKIES_TARGET_IMAGE=elastos/browser-selkies-runtime-target:dev

# Browser/video defaults. The compositor, capture, and page raster are fixed at
# 1920x1080 with DPR 1; only codec quality remains operator-tunable.
ELASTOS_BROWSER_SELKIES_ENCODER=x264enc
ELASTOS_BROWSER_SELKIES_FRAMERATE=30
ELASTOS_BROWSER_SELKIES_VIDEO_BITRATE=16
ELASTOS_BROWSER_SELKIES_H264_CRF=23

# Network policy for the local Exit Provider.
ELASTOS_BROWSER_SELKIES_ALLOWED_HOSTS=*
ELASTOS_BROWSER_SELKIES_ALLOWED_PORTS=80,443
ELASTOS_BROWSER_SELKIES_ADDRESS_FAMILY=prefer_ipv4

# Optional browser binary. Empty means the Playwright Chromium installed for
# the runtime browser tooling is used.
ELASTOS_BROWSER_SELKIES_BROWSER_PROGRAM=

# Optional STUN/TURN/TURNS servers, comma-separated. Example:
# ELASTOS_BROWSER_SELKIES_ICE_SERVERS=stun:stun.l.google.com:19302,turns:turn.example.com:5349
ELASTOS_BROWSER_SELKIES_ICE_SERVERS=
ELASTOS_BROWSER_SELKIES_ICE_USERNAME=
ELASTOS_BROWSER_SELKIES_ICE_CREDENTIAL=

# Selkies target auth. Leave password empty to generate one per service start.
ELASTOS_BROWSER_SELKIES_BASIC_AUTH_USER=ubuntu
ELASTOS_BROWSER_SELKIES_BASIC_AUTH_PASSWORD=

# Product proof defaults.
ELASTOS_BROWSER_SELKIES_VERIFY_URL=https://example.com/
ELASTOS_BROWSER_SELKIES_SMOKE_TIMEOUT_SECONDS=300
