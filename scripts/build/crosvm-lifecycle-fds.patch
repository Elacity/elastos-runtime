+/// Duplicate only explicitly inherited private regular-file leases. The descriptors
+/// belong to the device and each worker, independently of the crosvm leader.
+#[cfg(any(target_os = "android", target_os = "linux"))]
+fn retain_lifecycle_fds(fds: &[RawDescriptor]) -> SysResult<Arc<Vec<std::fs::File>>> {
+    use std::os::unix::fs::MetadataExt;
+
+    if fds.len() > 3
+        || fds.iter().any(|fd| *fd < 3)
+        || fds.iter().collect::<BTreeSet<_>>().len() != fds.len()
+    {
+        return Err(SysError::new(libc::EINVAL));
+    }
+    let mut identities = BTreeSet::new();
+    let mut retained = Vec::new();
+    for fd in fds {
+        let file = std::fs::File::from(base::safe_descriptor_from_cmdline_fd(fd)?);
+        let metadata = file
+            .metadata()
+            .map_err(|error| SysError::new(error.raw_os_error().unwrap_or(libc::EIO)))?;
+        // SAFETY: geteuid and F_GETFL do not access caller memory.
+        let uid = unsafe { libc::geteuid() };
+        let flags = unsafe { libc::fcntl(file.as_raw_descriptor(), libc::F_GETFL) };
+        if !metadata.is_file()
+            || metadata.uid() != uid
+            || metadata.nlink() != 1
+            || metadata.mode() & 0o077 != 0
+            || flags < 0
+            || flags & libc::O_ACCMODE != libc::O_RDWR
+            || !identities.insert((metadata.dev(), metadata.ino()))
+        {
+            return Err(SysError::new(libc::EINVAL));
+        }
+        retained.push(file);
+    }
+    Ok(Arc::new(retained))
+}
