+    #[test]
+    #[cfg(any(target_os = "android", target_os = "linux"))]
+    fn lifecycle_fds_reject_invalid_or_repeated_descriptors() {
+        assert!(retain_lifecycle_fds(&[0]).is_err());
+        assert!(retain_lifecycle_fds(&[-1]).is_err());
+        assert!(retain_lifecycle_fds(&[3, 4, 5, 6]).is_err());
+        assert!(retain_lifecycle_fds(&[3, 3]).is_err());
+        let closed_on_exec = tempfile().unwrap();
+        assert!(retain_lifecycle_fds(&[closed_on_exec.as_raw_descriptor()]).is_err());
+    }
+
+    #[test]
+    #[cfg(any(target_os = "android", target_os = "linux"))]
+    fn lifecycle_lease_is_preserved_by_the_real_block_worker() {
+        use std::os::fd::FromRawFd;
+
+        let (lease, lease_path) = tempfile::NamedTempFile::new().unwrap().into_parts();
+        // Simulate an inherited command-line FD without modifying the test harness FDs.
+        let fd = unsafe { libc::fcntl(lease.as_raw_descriptor(), libc::F_DUPFD, 64) };
+        assert!(fd >= 64);
+        let inherited = unsafe { std::fs::File::from_raw_fd(fd) };
+        base::flock(&inherited, base::FlockOperation::LockExclusive, true).unwrap();
+        let disk = tempfile().unwrap();
+        disk.set_len(4096).unwrap();
+        let options = DiskOption {
+            lifecycle_fds: vec![fd],
+            multiple_workers: true,
+            async_executor: Some(ExecutorKind::Sys(
+                cros_async::sys::linux::ExecutorKindSys::Epoll,
+            )),
+            ..Default::default()
+        };
+        let mut block = BlockAsync::new(0, Box::new(disk), &options, None, None, None).unwrap();
+        assert!(block
+            .keep_rds()
+            .contains(&block.lifecycle_fds[0].as_raw_descriptor()));
+        let mem = GuestMemory::new(&[(GuestAddress(0), 4 * 1024 * 1024)]).unwrap();
+        let interrupt = Interrupt::new_for_test();
+        let queues = (0..2)
+            .map(|index| {
+                let mut queue = QueueConfig::new(DEFAULT_QUEUE_SIZE, 0);
+                queue.set_ready(true);
+                (
+                    index,
+                    queue
+                        .activate(&mem, Event::new().unwrap(), interrupt.clone())
+                        .unwrap(),
+                )
+            })
+            .collect();
+        block.activate(mem, interrupt, queues).unwrap();
+        assert_eq!(block.worker_threads.len(), 2);
+        drop(inherited);
+        drop(lease);
+        block.lifecycle_fds = Arc::new(Vec::new());
+        let contender = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&lease_path)
+            .unwrap();
+        assert!(base::flock(&contender, base::FlockOperation::LockExclusive, true).is_err());
+        block.reset().unwrap();
+        assert!(base::flock(&contender, base::FlockOperation::LockExclusive, true).is_err());
+        drop(block); // Stops and joins all workers, whose final lease copies then close.
+        base::flock(&contender, base::FlockOperation::LockExclusive, true).unwrap();
+    }
