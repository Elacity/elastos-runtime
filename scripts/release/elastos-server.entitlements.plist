<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 6 Day 4 (Sub-3) — Apple Developer-ID entitlements for the
  signed `elastos-server` Mac binary.

  Why each entitlement is granted:

    com.apple.security.virtualization
      Required to instantiate VZVirtualMachine. Without it, the
      runtime cannot start any microVM via Apple Vz. This is the
      ONLY entitlement required for the default (NAT-only) capsule
      configuration.

    com.apple.security.hypervisor
      Required for the underlying Hypervisor.framework calls that
      Vz issues on Apple Silicon. Granted in tandem with
      `.virtualization`; refusing it produces an opaque
      VZErrorInternalError at machine.start() time.

    com.apple.vm.networking
      OPTIONAL — required only for the bridged-network capsule
      lane (capsules with `permissions.guest_network: true`). Phase 3
      Day 7 wired the runtime check (`elastos-vz/src/ffi/entitlement.rs`)
      that detects this entitlement at startup and routes accordingly:
      capsules using NAT-only networking succeed without it; capsules
      requesting bridged get a typed `Err(String)` naming this
      entitlement. Grant this here only when the Mac CI runner /
      operator wants to exercise the bridged path.

    com.apple.security.network.client
    com.apple.security.network.server
      Required because the Carrier-bridge guests reach out to host
      sockets the runtime opens (TCP listen on 127.0.0.1 for the
      RPC surface; outbound to IPFS gateways for content fetches).
      Both directions; both granted.

    com.apple.security.files.user-selected.read-write
      Required because the runtime reads operator-selected files
      (capsule rootfs paths, vmlinux paths) outside its containerised
      data directory.

  Notarization-related notes:
    - This plist must be supplied to `codesign --entitlements ...`
      at sign time; Apple's notary service verifies the plist
      against the signing cert at submission time.
    - `--options runtime` (hardened runtime) MUST be set in the
      same `codesign` invocation; without it, notarization
      rejects the binary even when the entitlements are valid.

  Anchor: docs/vz-backend/PHASE_3_DAY_7_NOTES.md (entitlement runtime
  check substrate), scripts/release-mac.sh (signing recipe that uses
  this plist).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.virtualization</key>
    <true/>

    <key>com.apple.security.hypervisor</key>
    <true/>

    <key>com.apple.vm.networking</key>
    <true/>

    <key>com.apple.security.network.client</key>
    <true/>

    <key>com.apple.security.network.server</key>
    <true/>

    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
