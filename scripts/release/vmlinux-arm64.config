# vmlinux-arm64.config — Phase 6 Day 6a kconfig fragment.
#
# Merged into the arm64 `defconfig` by `scripts/build-vmlinux-arm64.sh`
# via the kernel's built-in `scripts/kconfig/merge_config.sh`. The
# result is a self-consistent `.config` that boots inside Apple Vz
# (`VZLinuxBootLoader`) and supports the runtime's microVM contract.
#
# Authoring rules (kernel-merge_config.sh syntax):
#   - One `CONFIG_FOO=y` or `# CONFIG_FOO is not set` per line.
#   - Comments via `#` at line start.
#   - merge_config.sh in `-m` mode (used here) treats this file as
#     overrides on top of the base defconfig — any CONFIG_* listed
#     here wins; everything else stays at defconfig's default.
#   - olddefconfig downstream of the merge propagates dependencies
#     (e.g. enabling VIRTIO_VSOCKETS pulls in VSOCKETS + NET).
#
# Verified against the runtime's substrate contract:
#   - elastos-vz expects virtio-{console,net,blk,vsock} over PCI.
#   - capsule rootfs is ext4 (most commonly; some use squashfs+overlayfs).
#   - The Vz `VZLinuxBootLoader` consumes raw ARM64 `Image` format
#     identical to crosvm; no Apple-specific deltas in the kernel.
#
# Anchor: docs/vz-backend/PHASE_6_COMPONENTS_AUDIT.md § 4.3 Decision A
#         (same 6.1.59 source, recompiled for arm64).

# ── Virtio transport: PCI (the only one Vz exposes) ────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# ── Virtio devices the runtime + capsules use ──────────────────────────────
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_BALLOON=y

# ── vsock — host↔guest RPC channel the supervisor uses ─────────────────────
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# ── PCI host controller Vz exposes ─────────────────────────────────────────
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# ── Rootfs prerequisites ───────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y

# ── Core boot-time substrate ───────────────────────────────────────────────
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y

# ── Capsule isolation (matches the Linux crosvm guest contract) ────────────
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_MNT_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y

# ── Stripped-down: explicitly disable noisy / unneeded subsystems ──────────
# These trim a few MB off the Image and remove tens of seconds from
# boot probing on slower hosts. None are required for capsule operation.
# CONFIG_WIRELESS is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
