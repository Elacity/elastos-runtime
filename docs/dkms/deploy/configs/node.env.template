# dKMS authority node — environment file (EnvironmentFile for the systemd unit).
#
# Copy to /etc/elastos/dkms-authority.env on EACH node host and fill the placeholders.
# Grounded in capsules/dkms-authority/src/main.rs (these are the ONLY env vars the node reads).
# Mode: 0600, owner = the dkms service user. This file references NO secret of the runtime; the
# node's master seed lives in DKMS_AUTHORITY_KEY_STORE, never here.

# --- Transport -------------------------------------------------------------------------------
# Where this node BINDS + LISTENS. `tcp:HOST:PORT` for a remote node (the production shape), or an
# absolute unix-socket path for a co-located node. Bind to the node's WireGuard interface IP (NOT
# 0.0.0.0) so the listener is only reachable inside the private mesh.
#   Example: tcp:10.66.0.2:9443
DKMS_AUTHORITY_LISTEN=tcp:__THIS_NODE_WG_IP__:__PORT__

# --- Durable identity ------------------------------------------------------------------------
# The node's master-seed store. STABLE identity depends on this file persisting: back it up
# (encrypted, offline) and NEVER delete it — every CEK escrowed to this node is bound to the
# identity derived from this seed. Created 0600 on first launch; fail-closed if corrupt.
DKMS_AUTHORITY_KEY_STORE=/var/lib/elastos/dkms/master.seed

# --- Caller allow-list -----------------------------------------------------------------------
# Comma-separated base64 ML-DSA verifying keys the node will serve. Put the RUNTIME's caller VK
# here (the public half of dkms_caller_seed_b64 — derive it once with the runtime/operator tool).
# An unknown caller's `hello` is refused. Production MUST set this.
#
# DKMS-8 (fail-closed config): caller policy is now EXPLICIT and validated BEFORE the listener binds.
#   * set to a valid allow-list        -> the node enforces it.
#   * set but empty / malformed / with a duplicate entry -> STARTUP ERROR (never silently anonymous).
#   * unset AND no explicit anonymous  -> STARTUP ERROR (the operator must choose a policy).
# To run anonymous ("serve any well-formed caller", relying on the trustless grant gate) you MUST
# opt in explicitly: leave this UNSET and set DKMS_AUTHORITY_ALLOW_ANONYMOUS=1 (see below). Setting
# BOTH an allow-list and the anonymous flag is contradictory and also fails closed.
DKMS_AUTHORITY_ALLOWED_CALLERS=__RUNTIME_CALLER_VK_B64__

# EXPLICIT anonymous opt-in. Set to exactly `1` (with NO allow-list above) to serve any well-formed
# caller. Leave UNSET for an allow-listed deployment (the production posture). This exists so an
# anonymous node is a deliberate, auditable choice, never the silent result of a fat-fingered
# allow-list. Any value other than `1` is treated as "not opted in".
# DKMS_AUTHORITY_ALLOW_ANONYMOUS=1

# --- Operator identity (lifecycle authority) -------------------------------------------------
# Base64 ML-DSA operator verifying key pinned into the node. Authorizes lifecycle ops only
# (rotate_share, revoke_caller, reshare/reconfigure, dkg_*). The operator's SIGNING key lives off
# the node, on your operator console. Same value on ALL three nodes.
DKMS_AUTHORITY_OPERATOR_VK=__OPERATOR_VK_B64__
